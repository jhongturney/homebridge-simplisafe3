{
  "name": "homebridge-simplisafe3",
  "version": "2.0.1",
  "description": "A complete Homebridge plugin for the SimpliSafe 3 security system",
  "author": "Niccolò Zapponi, shamoon",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/shamoon"
  },
  "bin": {
    "homebridge-simplisafe3": "./bin/run"
  },
  "bugs": {
    "url": "https://github.com/homebridge-simplisafe3/homebridge-simplisafe3/issues"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.3.0",
    "@livekit/protocol": "1.54.1",
    "axios": "1.21.1",
    "axios-retry": "4.5.0",
    "ffmpeg-for-homebridge": "2.2.2",
    "is-docker": "4.0.0",
    "proper-lockfile": "4.1.2",
    "werift": "0.27.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/node": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "homebridge": "^2.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-compiler": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "homebridge": "^2.5.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "files": [
    "/bin",
    "/npm-shrinkwrap.json",
    "/simplisafe.js",
    "/accessories",
    "/commands",
    "/lib",
    "/homebridge-ui",
    "/config.schema.json",
    "/images",
    "/README.md"
  ],
  "homepage": "https://github.com/homebridge-simplisafe3/homebridge-simplisafe3#readme",
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "security",
    "simplisafe"
  ],
  "license": "MIT",
  "main": "index.js",
  "repository": "git+https://github.com/homebridge-simplisafe3/homebridge-simplisafe3.git",
  "scripts": {
    "build": "rm -rf dist && babel src -d dist --extensions .js,.ts && cp -r package.json config.schema.json homebridge-ui bin images README.md dist/",
    "deploy": "npm publish dist/",
    "start": "nodemon --exec babel-node src/index.js",
    "test": "npm run build && npm run test:unit && npm run test:webrtc && npm run test:http",
    "test:unit": "node --test test/*.test.cjs",
    "test:webrtc": "node --test test/webrtc.integration.cjs",
    "test:http": "node --test test/httpDeadline.integration.cjs",
    "lint": "eslint src",
    "typecheck": "node node_modules/typescript-compiler/bin/tsc",
    "package": "npm run build && node scripts/package.cjs",
    "test:package": "node scripts/verify-package.cjs"
  },
  "overrides": {
    "json-schema": ">=0.4.0",
    "cacache": {
      "glob": "^14.0.6"
    }
  }
}
