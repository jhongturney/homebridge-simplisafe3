{
  "name": "homebridge-simplisafe3",
  "version": "1.11.5-jhongturney.11",
  "description": "A complete Homebridge plugin for the SimpliSafe 3 security system",
  "author": "Niccolò Zapponi, shamoon",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/shamoon"
  },
  "bin": {
    "homebridge-simplisafe3": "./bin/run"
  },
  "bugs": {
    "url": "https://github.com/homebridge-simplisafe3/homebridge-simplisafe3/issues"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.7",
    "@livekit/protocol": "1.53.4",
    "axios": "1.21.0",
    "axios-retry": "4.5.0",
    "ffmpeg-for-homebridge": "2.2.2",
    "is-docker": "2.2.1",
    "proper-lockfile": "4.1.2",
    "werift": "0.26.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.6",
    "@babel/core": "^7.17.8",
    "@babel/node": "^7.16.8",
    "@babel/preset-env": "^7.16.11",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "homebridge": "^2.5.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "homebridge": "^1.11.4 || ^2.5.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "files": [
    "/bin",
    "/npm-shrinkwrap.json",
    "/simplisafe.js",
    "/accessories",
    "/commands",
    "/lib",
    "/homebridge-ui",
    "/config.schema.json",
    "/images",
    "/README.md"
  ],
  "homepage": "https://github.com/homebridge-simplisafe3/homebridge-simplisafe3#readme",
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "homekit",
    "security",
    "simplisafe"
  ],
  "license": "MIT",
  "main": "index.js",
  "repository": "git+https://github.com/homebridge-simplisafe3/homebridge-simplisafe3.git",
  "scripts": {
    "build": "rm -rf dist && babel src -d dist --extensions .js,.ts && cp -r package.json config.schema.json homebridge-ui bin images README.md dist/",
    "deploy": "npm publish dist/",
    "start": "nodemon --exec babel-node src/index.js",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test test/*.test.cjs",
    "test:webrtc": "node --test test/webrtc.integration.cjs",
    "test:http": "node --test test/httpDeadline.integration.cjs",
    "lint": "eslint src",
    "typecheck": "tsc"
  },
  "overrides": {
    "json-schema": ">=0.4.0"
  }
}
